<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html lang="en">
<head>
  <%@ include file="/WEB-INF/templates/head.jsp" %>
  <title>Report & Invoice | UrbanWear</title>
</head>
<body>

<%@ include file="/WEB-INF/templates/header.jsp" %>

<section class="admin-page">
  <div class="container">

    <div class="admin-hero">

      <c:choose>
        <c:when test="${reportMode}">
          <h1>Sales Report</h1>
        </c:when>

        <c:otherwise>
          <h1>Order Invoice</h1>
        </c:otherwise>
      </c:choose>
    </div>

    <div class="invoice-box">

      <div class="invoice-header">
        <div>
          <h1 class="invoice-title">UrbanWear</h1>

          <c:choose>
            <c:when test="${reportMode}">
              <p>Sales Report</p>
            </c:when>

            <c:otherwise>
              <p>Invoice for Order #${order.orderId}</p>
            </c:otherwise>
          </c:choose>
        </div>

        <button onclick="window.print()" class="primary-btn">
          Print
        </button>
      </div>

      <c:choose>

        <c:when test="${reportMode}">

          <div class="report-grid">

            <div class="report-card">
              <h3>Total Orders</h3>
              <h2>${totalOrders}</h2>
            </div>

            <div class="report-card">
              <h3>Total Revenue</h3>
              <h2>Rs. ${totalRevenue}</h2>
            </div>

            <div class="report-card">
              <h3>Generated By</h3>
              <h2>Admin</h2>
            </div>

          </div>

          <div class="table-scroll">
            <table class="report-table">
              <thead>
              <tr>
                <th>Order ID</th>
                <th>User ID</th>
                <th>Date</th>
                <th>Status</th>
                <th>Total</th>
              </tr>
              </thead>

              <tbody>
              <c:forEach var="o" items="${orders}">
                <tr>
                  <td>#${o.orderId}</td>
                  <td>User-${o.userId}</td>
                  <td>${o.orderDate}</td>
                  <td>
                                        <span class="status-badge
                                            ${o.status eq 'Cancelled' ? 'status-cancelled' :
                                              o.status eq 'Delivered' ? 'status-completed' :
                                              o.status eq 'Returned' ? 'status-returned' :
                                              'status-pending'}">
                                            ${o.status}
                                        </span>
                  </td>
                  <td>Rs. ${o.totalAmount}</td>
                </tr>
              </c:forEach>
              </tbody>
            </table>
          </div>

          <div class="invoice-total">
            <h2>Grand Total: Rs. ${totalRevenue}</h2>
          </div>

          <div class="invoice-actions">
            <button onclick="window.print()" class="primary-btn">
              Print Report
            </button>

            <a href="${pageContext.request.contextPath}/admin/orders"
               class="secondary-btn">
              Back To Orders
            </a>
          </div>

        </c:when>

        <c:otherwise>

          <div class="report-grid">

            <div class="report-card">
              <h3>Order ID</h3>
              <h2>#${order.orderId}</h2>
            </div>

            <div class="report-card">
              <h3>User ID</h3>
              <h2>User-${order.userId}</h2>
            </div>

            <div class="report-card">
              <h3>Status</h3>
              <h2>${order.status}</h2>
            </div>

          </div>

          <div class="table-scroll">
            <table class="report-table">
              <thead>
              <tr>
                <th>Product ID</th>
                <th>Size</th>
                <th>Color</th>
                <th>Quantity</th>
                <th>Price</th>
                <th>Subtotal</th>
              </tr>
              </thead>

              <tbody>
              <c:forEach var="item" items="${orderItems}">
                <tr>
                  <td>#${item.productId}</td>
                  <td>${item.size}</td>
                  <td>${item.color}</td>
                  <td>${item.quantity}</td>
                  <td>Rs. ${item.price}</td>
                  <td>Rs. ${item.price * item.quantity}</td>
                </tr>
              </c:forEach>
              </tbody>
            </table>
          </div>

          <div class="invoice-total">
            <h2>Grand Total: Rs. ${order.totalAmount}</h2>
          </div>

          <div class="invoice-actions">
            <button onclick="window.print()" class="primary-btn">
              Print Invoice
            </button>

            <a href="${pageContext.request.contextPath}/admin/orders"
               class="secondary-btn">
              Back To Orders
            </a>
          </div>

        </c:otherwise>

      </c:choose>

    </div>

  </div>
</section>

<%@ include file="/WEB-INF/templates/footer.jsp" %>

</body>
</html>